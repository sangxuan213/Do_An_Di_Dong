rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function active() {
      return !exists(userPath()) || get(userPath()).data.get('disabled', false) == false;
    }
    function signedIn() { return request.auth != null && active(); }
    function isAdmin() {
      return signedIn() && get(userPath()).data.role == 'ADMIN';
    }

    match /users/{uid} {
      // người bị khóa vẫn đọc được hồ sơ của chính mình để app biết mà đăng xuất
      allow read: if request.auth != null && (request.auth.uid == uid || active());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'STUDENT';
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
        || isAdmin());
      allow delete: if isAdmin();

      // Thích và số sao của riêng từng người (app: FirebaseInteractionRepositoryImpl)
      match /interactions/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Mình đang theo dõi ai (chỉ chủ tài khoản đọc/ghi)
      match /following/{otherUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Ai đang theo dõi tài khoản này: ai cũng đếm được, mỗi người chỉ thêm/xóa chính mình
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == followerUid;
      }
    }

    // Danh sách môn học: ai cũng đọc, chỉ admin sửa (app: FirebaseCourseRepositoryImpl)
    match /courses/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /documents/{docId} {
      allow read, create: if signedIn();
      // Chủ tài liệu và admin sửa tự do; người khác chỉ được đổi các bộ đếm (xem, thích, đánh giá)
      allow update: if signedIn() && (
        resource.data.uploadedBy == request.auth.uid
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewCount', 'likeCount', 'ratingSum', 'ratingCount']));
      allow delete: if signedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());

      match /chunks/{chunkId} {
        allow read, create: if signedIn();
        allow delete: if signedIn() && (
          get(/databases/$(database)/documents/documents/$(docId)).data.uploadedBy == request.auth.uid
          || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /dispatches/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // Không cho thêm/bớt người trong cuộc trò chuyện sau khi tạo
      allow update: if signedIn() && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
